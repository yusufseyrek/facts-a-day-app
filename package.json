{
  "name": "facts-a-day-app",
  "version": "1.3.4",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "bash scripts/ios-release.sh",
    "register:embedded:ios": "bash scripts/register-embedded-ios.sh",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "register:embedded:android": "bash scripts/register-embedded-android.sh",
    "clean": "npx expo prebuild --clean",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --forceExit --coverage --collectCoverageFrom='src/services/**/*.ts' --collectCoverageFrom='src/utils/insertNativeAds.ts'",
    "build:ios": "./scripts/build-ios.sh",
    "build:android": "./scripts/build-android.sh",
    "update:ios": "bun scripts/publish-ota.ts --platform ios --release",
    "update:android": "bun scripts/publish-ota.ts --platform android --release",
    "update:all": "bun scripts/publish-ota.ts --platform all --release"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-view-shot"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "posthog-react-native-session-replay"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testTimeout": 1e4,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@shopify/flash-list|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|i18n-js|react-native-google-mobile-ads|react-native-reanimated|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-worklets)"
    ],
    "moduleNameMapper": {
      "^@react-native-firebase/app$": "<rootDir>/src/__tests__/__mocks__/firebase/app.ts",
      "^@react-native-firebase/app-check$": "<rootDir>/src/__tests__/__mocks__/firebase/appCheck.ts",
      "^@react-native-firebase/analytics$": "<rootDir>/src/__tests__/__mocks__/firebase/analytics.ts",
      "^@react-native-firebase/crashlytics$": "<rootDir>/src/__tests__/__mocks__/firebase/crashlytics.ts"
    }
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/app-check": "^25.1.0",
    "@react-native-firebase/crashlytics": "^25.1.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "expo": "~57.0.2",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-background-task": "~57.0.2",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-iap": "^3.4.8",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-navigation-bar": "~57.0.1",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.2",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.0",
    "expo-task-manager": "~57.0.2",
    "expo-tracking-transparency": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "i18n-js": "^4.5.3",
    "posthog-react-native": "^4.54.4",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "~0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "patchedDependencies": {
    "react-native-google-mobile-ads@16.4.0": "patches/react-native-google-mobile-ads@16.4.0.patch"
  }
}
